# ─────────────────────────────────────────────────────────────────
# .env.example — Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# Groq API key (required)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Path to the preprocessed Parquet dataset (relative to project root)
DATA_PATH=data/processed/restaurants.parquet

# Groq model to use for recommendations
LLM_MODEL=openai/gpt-oss-120b

# Maximum number of candidate restaurants passed to the LLM
MAX_CANDIDATES=15

# FastAPI backend URL (used by the Streamlit UI)
API_BASE_URL=http://localhost:8000
